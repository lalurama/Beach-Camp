APP_NAME="Beach Camp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Port Web Server Nginx (80 untuk server VPS langsung, atau 8000 jika di balik reverse proxy)
APP_PORT=80

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- OPSI 1: Database MySQL (Default di Docker Compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=beachcamp
DB_USERNAME=beachcamp
DB_PASSWORD=BeachCampSecure2026
DB_ROOT_PASSWORD=BeachCampRoot2026
FORWARD_DB_PORT=3306

# --- OPSI 2: Database SQLite (Jika tidak ingin menjalankan container MySQL) ---
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@beachcamp.id"
MAIL_FROM_NAME="${APP_NAME}"
